# SPA build-time endpoints (read by Vite). Unset = same-origin /inbox/ and
# /validate (works behind the nginx proxy). Override per machine in .env.local
# (dev) or via docker build args.
#VITE_INBOX_URL=http://localhost:5051/inbox/
#VITE_VALIDATOR_URL=http://localhost:3000/validate

# Docker only: where nginx proxies /validate to (scheme://host:port, no path).
# Default reaches a validator on the docker host. Leave VITE_VALIDATOR_URL unset
# so the SPA uses same-origin /validate through this proxy.
#VALIDATOR_UPSTREAM=http://validator:3000

# Server-side forwarding relay (opt-in). Blank VITE_RELAY_URL = SPA sends
# directly from the browser (default, unchanged). Docker ships the relay
# same-origin at /relay/ (see docker-compose). Tokens live as files in
# RELAY_TOKEN_DIR: the filename is the bearer token, the file body is metadata
# (a `To:` line names the recipient). Empty/absent dir => relay refuses all (503).
# The relay logs log4js-style and reuses the LOG4JS level below (override just
# the relay with RELAY_LOG_LEVEL).
#VITE_RELAY_URL=http://localhost:5052/relay/
#RELAY_PORT=5052
#RELAY_TOKEN_DIR=token
#RELAY_ALLOW_ORIGIN=*
#RELAY_LOG_LEVEL=info
# create a token: mkdir -p token && printf 'To: DSpace repo admin\n' > token/$(openssl rand -hex 16)

LOG4JS=INFO
LDN_SERVER_HOST=localhost
LDN_SERVER_PORT=5051
LDN_SERVER_INBOX_GLOB="^.*\.jsonld$"
LDN_SERVER_BASEURL=http://localhost:5051
LDN_SERVER_INBOX_BATH_SIZE=5
LDN_SERVER_INBOX_URL=inbox/
LDN_SERVER_INBOX_PATH=./inbox
LDN_SERVER_ERROR_PATH=./error
LDN_SERVER_OUTBOX_PATH=./outbox
LDN_SERVER_PUBLIC_PATH=./public
LDN_SERVER_JSON_SCHEMA=./config/notification.json
#LDN_SERVER_INBOX_CONFIG=./config/inbox_config.json
#LDN_SERVER_OUTBOX_CONFIG=./config/outbox_config.json
LDN_SERVER_HAS_PUBLIC_INBOX=1
LDN_SERVER_MAX_UPLOAD_SIZE=10000
LDN_SERVER_RATE_LIMIT=60
LDN_SERVER_RATE_WINDOW=60
LDN_SERVER_INBOX_STAT=1