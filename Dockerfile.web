# Build the Vite SPA
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_INBOX_URL
ARG VITE_VALIDATOR_URL
ARG VITE_RELAY_URL
ENV VITE_INBOX_URL=$VITE_INBOX_URL
ENV VITE_VALIDATOR_URL=$VITE_VALIDATOR_URL
ENV VITE_RELAY_URL=$VITE_RELAY_URL
RUN npm run build

# Serve the build with nginx
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Template: the entrypoint runs envsubst (${VALIDATOR_UPSTREAM}) -> conf.d/default.conf
COPY conf/nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
